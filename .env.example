# PostgreSQL connection
DATABASE_URL=postgres://accounting:accounting@localhost:5432/accounting

# Secret used for session cookies and encrypting stored MyInvois credentials.
# Generate with: openssl rand -hex 32
APP_SECRET=change-me

# Optional: override MyInvois endpoints (normally derived from the
# environment selected in Settings; only set these for testing).
# MYINVOIS_API_BASE_URL=
# MYINVOIS_PORTAL_BASE_URL=
